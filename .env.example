VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Opsionale: publikimi direkt në Instagram (shiko docs/INSTAGRAM_SETUP.md)
VITE_INSTAGRAM_APP_ID=
VITE_INSTAGRAM_REDIRECT_URI=https://emri-yt.vercel.app/

# Sekrete të serverit (Supabase Edge Functions, JO në Vercel dhe JO me parashtesën VITE_):
# GROQ_API_KEY=            çelësi falas nga console.groq.com/keys, për analyze-post-image
# IMAGE_ANALYSIS_MODEL=    opsionale; parazgjedhja është qwen/qwen3.8-27b
# INSTAGRAM_APP_ID, INSTAGRAM_APP_SECRET, INSTAGRAM_REDIRECT_URI shihen te docs/INSTAGRAM_SETUP.md
# Plani falas i Groq: rreth 30 kërkesa/minutë dhe 1000/ditë. Një foto hyn si 2048 tokenë.
# Jashtë planit falas Groq liston rreth $0.80 / 1M tokenë hyrje dhe $4 / 1M tokenë dalje.
